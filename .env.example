# ============================================================
# M.A.U.R.Y.A. Environment Configuration
# ============================================================

# Application
MAURYA_APP_NAME=M.A.U.R.Y.A.
MAURYA_ENVIRONMENT=development
MAURYA_DEBUG=false
MAURYA_LOG_LEVEL=INFO

# API
MAURYA_API_PREFIX=/api/v1

# Database
MAURYA_DATABASE_URL=sqlite+aiosqlite:///./data/osint.db

# External intelligence providers
MAURYA_SHODAN_API_KEY=

# Network behavior
MAURYA_HTTP_TIMEOUT_SECONDS=10.0
MAURYA_MAX_CONCURRENCY=20